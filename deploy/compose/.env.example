# Copy to .env. Both passwords must be set; generate them, for example with: openssl rand -base64 24
TOOLKIT_DB_PASSWORD=
TOOLKIT_ADMIN_PASSWORD=
# The source export, mounted read-only: a git checkout or a PDS dump.
TOOLKIT_SOURCE=/data/export
# The modern repository, if there is one.
#TOOLKIT_TARGET=/data/modern-app
TOOLKIT_HTTPS_PORT=8443
# After the client's identity provider is ready:
#TOOLKIT_OIDC_ISSUER=https://login.example.internal/realms/main
#TOOLKIT_OIDC_CLIENT=toolkit
# Named by toolkit.yaml; never put these in that file.
#TOOLKIT_LLM_KEY=
#TOOLKIT_ZOS_USER=
#TOOLKIT_ZOS_PASS=
# Air-gapped: refuse to contact any registry.
#TOOLKIT_PULL_POLICY=never
