# Every block of config\toolkit.yaml, with example values. `toolkit.cmd setup` writes a working toolkit.yaml for you;
# copy blocks from here into it as you need them. Secrets never go in this file: put them in config\toolkit.env
# (NAME=value lines) and name the variable here (api_key_env, user_env, password_env).
# Paths may use / or \. Quote a path that contains a space or a colon: 'D:/Mainframe export'.
client: acme-insurance
source:
  root: 'D:/Mainframe export'   # a git checkout or a PDS export, as files
  refresh: manual               # manual | git
  encoding: auto                # auto | cp037 | cp1047 | utf-8
  format: auto                  # auto | fixed | free
  dialect: ibm-enterprise       # ibm-enterprise | microfocus
  include: ["**/*"]
  exclude: ["**/*.lst"]

