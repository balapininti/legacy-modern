package ${testPackage};

import static org.junit.jupiter.api.Assertions.assertTrue;

import com.fasterxml.jackson.databind.JsonNode;
import java.util.ArrayList;
import java.util.List;
import java.util.stream.Stream;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.MethodSource;

/**
 * Characterization tests for ${program}, from captures of the program running (${source}).
 * Generated by the toolkit. Do not edit an expected value to make a test pass: see CharacterizationSupport.
 */
class ${className} {
    static Stream<String> fixtures() {
        return Stream.of(<#list fixtures as f>"${f}"<#sep>, </#sep></#list>);
    }

    @ParameterizedTest
    @MethodSource("fixtures")
    void behavesLikeTheMainframe(String fixture) throws Exception {
        JsonNode input = CharacterizationSupport.resource("characterization/${program}/" + fixture + ".input.json");
        JsonNode expected = CharacterizationSupport.resource("characterization/${program}/" + fixture + ".expected.json");
        JsonNode deviations = CharacterizationSupport.resource("characterization/${program}/deviations.json");
        JsonNode actual = new ${adapter}().run(input);
        List<CharacterizationSupport.Difference> diffs = new ArrayList<>(CharacterizationSupport.compare(expected, actual, deviations));
        if (!diffs.isEmpty()) CharacterizationSupport.report("${program}", fixture, diffs);
        assertTrue(diffs.isEmpty(), () -> diffs.size() + " differences from the capture in fields " + diffs.stream().map(CharacterizationSupport.Difference::field).distinct().toList() + ", first: " + diffs.get(0));
    }
}
