package ${testPackage};

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import java.io.IOException;
import java.io.InputStream;
import java.math.BigDecimal;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

/**
 * Field by field comparison of what the Java produced against what the mainframe wrote. Generated by the toolkit.
 * A difference covered by an approved deviation passes. Any other fails, and lands in target/characterization-diffs
 * for a lead: `toolkit tests report` turns them into candidate deviations.
 */
final class CharacterizationSupport {
    private static final ObjectMapper JSON = new ObjectMapper();

    record Difference(String dataset, int record, String field, String expected, String actual) {}

    private CharacterizationSupport() {}

    static JsonNode resource(String path) throws IOException {
        try (InputStream in = CharacterizationSupport.class.getResourceAsStream("/" + path)) {
            if (in == null) throw new IOException("missing test resource " + path);
            return JSON.readTree(in);
        }
    }

    static List<Difference> compare(JsonNode expected, JsonNode actual, JsonNode deviations) {
        List<Difference> out = new ArrayList<>();
        for (Iterator<String> it = expected.fieldNames(); it.hasNext();) {
            String dataset = it.next();
            JsonNode e = expected.get(dataset), a = actual.path(dataset);
            int n = Math.max(e.size(), a.size());
            for (int i = 0; i < n; i++) {
                if (i >= e.size() || i >= a.size()) {
                    out.add(new Difference(dataset, i, "(record)", i < e.size() ? "present" : "absent", i < a.size() ? "present" : "absent"));
                    continue;
                }
                for (Iterator<String> f = e.get(i).fieldNames(); f.hasNext();) {
                    String field = f.next();
                    String x = text(e.get(i).get(field)), y = text(a.get(i).get(field));
                    if (!same(field, x, y, deviations)) out.add(new Difference(dataset, i, field, x, y));
                }
            }
        }
        return out;
    }

    private static String text(JsonNode n) {
        return n == null || n.isNull() ? null : n.isTextual() ? n.asText() : n.toString();
    }

    private static boolean same(String field, String x, String y, JsonNode deviations) {
        for (JsonNode d : deviations) {
            JsonNode r = d.path("comparison_rule");
            if (!field.equalsIgnoreCase(r.path("field").asText())) continue;
            switch (r.path("kind").asText()) {
                case "ignore_field" -> {
                    return true;
                }
                case "numeric_tolerance" -> {
                    if (number(x) != null && number(y) != null && number(x).subtract(number(y)).abs().compareTo(new BigDecimal(r.path("tolerance").asText("0"))) <= 0) return true;
                }
                case "expected_transformation" -> {
                    if (x != null && y != null && x.strip().replaceAll(r.path("from").asText(), r.path("to").asText()).equals(y.strip())) return true;
                }
                case "expected_new_behavior" -> {
                    if (y != null && y.strip().equals(r.path("value").asText().strip())) return true;
                }
                default -> { }
            }
        }
        return equal(x, y);
    }

    /** COBOL's own comparison rules: spaces pad on the right, and 1.50 equals 1.5. */
    private static boolean equal(String x, String y) {
        if (x == null || y == null) return x == null && y == null;
        if (x.stripTrailing().equals(y.stripTrailing())) return true;
        BigDecimal a = number(x), b = number(y);
        return a != null && b != null && a.compareTo(b) == 0;
    }

    private static BigDecimal number(String s) {
        if (s == null) return null;
        try {
            return new BigDecimal(s.strip());
        } catch (NumberFormatException e) {
            return null;
        }
    }

    static void report(String program, String fixture, List<Difference> diffs) throws IOException {
        Path dir = Path.of("target/characterization-diffs");
        Files.createDirectories(dir);
        ObjectNode o = JSON.createObjectNode();
        o.put("program", program);
        o.put("fixture", fixture);
        o.set("differences", JSON.valueToTree(diffs));
        JSON.writerWithDefaultPrettyPrinter().writeValue(dir.resolve(program + "-" + fixture + ".json").toFile(), o);
    }
}
